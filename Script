local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "Victor Core"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0,280,0,500)
frame.Position = UDim2.new(.5,-140,.5,-250)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,40)
title.Text = "⚡ Victor Core ⚡"
title.TextScaled = true
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.Parent = frame

local function makeButton(text,y)
local b = Instance.new("TextButton")
b.Size = UDim2.new(.8,0,0,35)
b.Position = UDim2.new(.1,0,0,y)
b.Text = text
b.Parent = frame
return b
end

local minimize = makeButton("-",5)
minimize.Size = UDim2.new(0,35,0,25)
minimize.Position = UDim2.new(.85,0,0,5)

local fly = makeButton("Fly OFF",55)
local noclip = makeButton("Noclip OFF",100)
local infjump = makeButton("Inf Jump OFF",145)
local save = makeButton("Save Position",190)
local load = makeButton("Load Position",235)

local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(.8,0,0,35)
speedBox.Position = UDim2.new(.1,0,0,285)
speedBox.PlaceholderText = "WalkSpeed"
speedBox.Parent = frame

local speedButton = makeButton("Set WalkSpeed",330)

local jumpBox = Instance.new("TextBox")
jumpBox.Size = UDim2.new(.8,0,0,35)
jumpBox.Position = UDim2.new(.1,0,0,375)
jumpBox.PlaceholderText = "JumpPower"
jumpBox.Parent = frame

local jumpButton = makeButton("Set JumpPower",420)

local reopen = Instance.new("TextButton")
reopen.Size = UDim2.new(0,140,0,40)
reopen.Position = UDim2.new(0,20,.5,0)
reopen.Text = "⚡ Victor Core"
reopen.Visible = false
reopen.Active = true
reopen.Parent = gui
local savedPosition = nil
local flyOn = false
local noclipOn = false
local infJumpOn = false
local flyingVelocity

local function getChar()
return player.Character
end

local function getRoot()
local char = getChar()
return char and char:FindFirstChild("HumanoidRootPart")
end

-- Minimize
minimize.MouseButton1Click:Connect(function()
frame.Visible = false
reopen.Visible = true
end)

reopen.MouseButton1Click:Connect(function()
frame.Visible = true
reopen.Visible = false
end)

-- Save position
save.MouseButton1Click:Connect(function()
local root = getRoot()
if root then
savedPosition = root.CFrame
save.Text = "Saved!"
end
end)

-- Load position
load.MouseButton1Click:Connect(function()
local root = getRoot()
if root and savedPosition then
root.CFrame = savedPosition
load.Text = "Loaded!"
end
end)

-- Walk speed
speedButton.MouseButton1Click:Connect(function()
local hum = getChar() and getChar():FindFirstChildOfClass("Humanoid")
local value = tonumber(speedBox.Text)

if hum and value then
hum.WalkSpeed = value
end
end)

-- Jump power
jumpButton.MouseButton1Click:Connect(function()
local hum = getChar() and getChar():FindFirstChildOfClass("Humanoid")
local value = tonumber(jumpBox.Text)

if hum and value then
hum.UseJumpPower = true
hum.JumpPower = value
end
end)

-- Fly
fly.MouseButton1Click:Connect(function()
flyOn = not flyOn
fly.Text = flyOn and "Fly ON" or "Fly OFF"

local root = getRoot()

if flyOn and root then
flyingVelocity = Instance.new("BodyVelocity")
flyingVelocity.MaxForce = Vector3.new(999999,999999,999999)
flyingVelocity.Parent = root
elseif flyingVelocity then
flyingVelocity:Destroy()
flyingVelocity = nil
end
end)

RunService.RenderStepped:Connect(function()
if flyOn and flyingVelocity then
flyingVelocity.Velocity =
workspace.CurrentCamera.CFrame.LookVector * 60
end

if noclipOn then
local char = getChar()
if char then
for _,v in pairs(char:GetDescendants()) do
if v:IsA("BasePart") then
v.CanCollide = false
end
end
end
end
end)

-- Noclip
noclip.MouseButton1Click:Connect(function()
noclipOn = not noclipOn
noclip.Text = noclipOn and "Noclip ON" or "Noclip OFF"
end)

-- Infinite jump
infjump.MouseButton1Click:Connect(function()
infJumpOn = not infJumpOn
infjump.Text = infJumpOn and "Inf Jump ON" or "Inf Jump OFF"
end)

UIS.JumpRequest:Connect(function()
if infJumpOn then
local hum = getChar() and getChar():FindFirstChildOfClass("Humanoid")
if hum then
hum:ChangeState(Enum.HumanoidStateType.Jumping)
end
end
end)





